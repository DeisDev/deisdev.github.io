---
import '../style.css';
import Icon from '../components/Icon.astro';
import SquareField from '../components/SquareField.astro';
import Stats from '../components/Stats.astro';
import stats from '../../data/stats.json';
import featured from '../../data/projects.json';

const socials = [
  { name: 'GitHub', icon: 'github' as const, label: '@DeisDev', url: 'https://github.com/DeisDev' },
  { name: 'Steam', icon: 'steam' as const, label: 'cat sniffer', url: 'https://steamcommunity.com/id/catsniffermeow' },
  { name: 'Nexus Mods', icon: 'nexusmods' as const, label: '@DeisDev', url: 'https://www.nexusmods.com/profile/DeisDev/mods' },
  { name: 'Modrinth', icon: 'modrinth' as const, label: '@DeisDev', url: 'https://modrinth.com/user/DeisDev' },
];
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="color-scheme" content="dark" />
    <meta name="theme-color" content="#000000" />
    <meta name="description" content="DeisDev — About Me, Projects, and Contact." />
    <title>DeisDev — Personal space</title>
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <link rel="preload" href="/doto-latin-800.woff2" as="font" type="font/woff2" crossorigin />
  </head>
  <body>
    <a class="skip-link" href="#main">Skip to content</a>
    <div class="site-shell" id="top">
      <header class="site-header">
        <a class="brand" href="#top" aria-label="DeisDev home"><span class="brand-mark" aria-hidden="true">{Array.from({ length: 9 }, () => <i />)}</span>deisdev<span class="brand-period">.</span></a>
        <nav aria-label="Main navigation">
          <a href="#about"><span>01</span> About</a>
          <a href="#projects"><span>02</span> Projects</a>
          <a href="#contact"><span>03</span> Contact</a>
        </nav>
        <a class="header-github" href="https://github.com/DeisDev" target="_blank" rel="noreferrer"><Icon name="github" size={17} /><span>GitHub</span><Icon name="arrow" size={13} /></a>
      </header>

      <main id="main" tabindex="-1">
        <section class="hero" aria-labelledby="hero-title">
          <div class="hero-grid" aria-hidden="true"></div>
          <SquareField />
          <div class="hero-content">
            <div class="eyebrow hero-eyebrow"><span class="status-square"></span> Personal space <span class="slash">/</span> {new Date().getFullYear()}</div>
            <h1 id="hero-title">DeisDev<span>.</span></h1>
            <p class="hero-description">Hey, I'm DeisDev. I'm a hobbyist developer and modder based out of <span class="country">Canada <img class="country-flag" src="/flag-canada.svg" width="24" height="12" alt="" /></span>. This site is where I'll put some things that I'm particularly proud of.</p>
            <div class="hero-actions"><a class="button button-primary" href="#projects">Explore projects <Icon name="down" size={16} /></a><a class="button button-secondary" href="#about">A little about me <Icon name="arrow" size={14} /></a></div>
          </div>
          <div class="art-caption tiny" aria-hidden="true"><span>FIG. 001</span><span>A study in squares</span><span class="cross">+</span></div>
          <div class="hero-footer"><a class="tiny scroll-prompt" href="#about"><span class="scroll-line" aria-hidden="true"></span> Scroll to explore</a><button id="motion-toggle" class="motion-toggle tiny" type="button" aria-pressed="true" hidden><span class="motion-indicator" aria-hidden="true"><i></i><i></i><i></i></span><span data-motion-label>Motion on</span></button></div>
        </section>

        <section class="section about-section" id="about" aria-labelledby="about-title">
          <div class="section-topline"><span class="eyebrow"><span class="section-number">01</span> The introduction</span><span class="tiny">A little context</span></div>
          <div class="about-grid">
            <div class="about-copy"><h2 id="about-title">About me<span>.</span></h2><p class="body-large">I started making mods for games at the age of 16! I have always had a passion for creating and sharing content with people in various communities / niches. I LOVED forge mode on halo; that was like my first taste of UGC I think ever.</p><p>Nowadays you'll see me working on various projects and usually I'm working on multiple at once, because yknow, why make life easier? I have skills in Web Frontend Development, Content Creation, Photoshop / Graphic Design, Modding, and Game Development. </p><div class="interest-tags"><span><i></i>Code</span><span><i></i>Mods</span><span><i></i>Experiments</span></div></div>
            <aside class="elsewhere" aria-label="Social profiles"><span class="eyebrow">Elsewhere on the internet</span><div class="social-list">{socials.map((social) => <a href={social.url} target="_blank" rel="noreferrer"><Icon name={social.icon} size={19} /><span>{social.name}<small>{social.label}</small></span><Icon name="arrow" size={14} /></a>)}</div></aside>
          </div>
          <Stats />
        </section>

        <section class="section projects-section" id="projects" aria-labelledby="projects-title">
          <div class="section-topline"><span class="eyebrow"><span class="section-number">02</span> The things I make</span><span class="tiny">Selected work / 02</span></div>
          <div class="section-title-row"><h2 id="projects-title">Projects<span>.</span></h2><a class="text-link" href="https://github.com/DeisDev?tab=repositories" target="_blank" rel="noreferrer">All repositories <Icon name="arrow" size={14} /></a></div>
          <div class="project-grid">
            <article class="project-card">
              <a class="project-art" style="--project-artwork: url('/better-lights.gif')" href="https://steamcommunity.com/sharedfiles/filedetails/?id=3597784225" target="_blank" rel="noreferrer" aria-label="View Better Lights on Steam Workshop">
                <img class="project-image" src="/better-lights.gif" width="512" height="512" alt="Better Lights lighting comparison" loading="lazy" decoding="async" />
              </a>
              <div class="project-content"><div class="project-heading"><h3>Better Lights</h3><span class="tag">Game mod</span></div><p>Configurable dynamic lighting for Garry's Mod.</p><div class="project-links"><a href="https://steamcommunity.com/sharedfiles/filedetails/?id=3597784225" target="_blank" rel="noreferrer"><Icon name="steam" size={16} />Workshop <Icon name="arrow" size={12} /></a><a href="https://github.com/DeisDev/BetterLights" target="_blank" rel="noreferrer"><Icon name="github" size={15} />Source <Icon name="arrow" size={12} /></a></div></div>
            </article>
            <article class="project-card">
              <a class="project-art" style="--project-artwork: url('/nwmpublisher.svg')" href={featured.repoUrl} target="_blank" rel="noreferrer" aria-label="View nwmpublisher on GitHub">
                <img class="project-image project-logo" src="/nwmpublisher.svg" width="250" height="250" alt="nwmpublisher logo" loading="lazy" decoding="async" />
              </a>
              <div class="project-content"><div class="project-heading"><h3>{featured.name}</h3><span class="tag">Utility</span></div><p>A fork of gmpublisher. At it's core, it's still the same feature-packed workshop publisher for Garry's Mod, but now with some improvements made in various areas such as quality of life and stability. An example would be that you now have the ability to edit the desription, changelog, visibility, and most of the other workshop facing controls, all from the program. Something that was possible in upstream but never implemented.</p><div class="project-links"><a href={stats.release.url} target="_blank" rel="noreferrer">v{stats.release.version.replace(/^v/, '')} <Icon name="down" size={14} />Download</a><a href={featured.repoUrl} target="_blank" rel="noreferrer"><Icon name="github" size={15} />Source <Icon name="arrow" size={12} /></a></div></div>
            </article>
          </div>
          <div class="project-footnote tiny"><span class="status-square"></span><span>More in the works<span aria-hidden="true">_</span></span><span class="dashed-line"></span><span>Always exploring</span></div>
        </section>

        <section class="section contact-section" id="contact" aria-labelledby="contact-title">
          <div class="section-topline"><span class="eyebrow"><span class="section-number">03</span> The next conversation</span><span class="tiny">Say hello</span></div>
          <div class="contact-grid"><div><h2 id="contact-title">Let's talk<span>.</span></h2><p>Commisions, collaborations, and other inquiries are welcome. Hire me?</p><a class="email-link" href="mailto:dev@deis.me">dev@deis.me <Icon name="arrow" size={28} /></a></div><div class="contact-options"><a href="mailto:dev@deis.me"><Icon name="mail" size={20} /><span>Email<small>dev@deis.me</small></span><Icon name="arrow" size={16} /></a><a href="https://buymeacoffee.com/deisdev" target="_blank" rel="noreferrer"><Icon name="buymeacoffee" size={20} /><span>Buy Me a Coffee<small>@deisdev</small></span><Icon name="arrow" size={16} /></a><div class="discord-contact"><Icon name="discord" size={20} /><span>Discord<small>@catsniffur</small></span><button type="button" id="copy-discord" aria-label="Copy Discord username catsniffur" hidden><Icon name="copy" size={16} /></button></div><span id="copy-status" class="tiny copy-status" role="status" aria-live="polite"></span></div></div>
        </section>
      </main>

      <footer class="site-footer"><a class="footer-brand" href="#top">deisdev<span>.</span></a><span class="tiny">© {new Date().getFullYear()} DeisDev</span><a href="#top" class="tiny">Back to top <Icon name="arrow" size={13} /></a></footer>
    </div>
    <script>
      const copyButton = document.querySelector<HTMLButtonElement>('#copy-discord');
      const copyStatus = document.querySelector<HTMLElement>('#copy-status');
      if (copyButton && copyStatus && navigator.clipboard) {
        copyButton.hidden = false;
        copyButton.addEventListener('click', async () => {
          try {
            await navigator.clipboard.writeText('catsniffur');
            copyStatus.textContent = 'Username copied.';
          } catch {
            copyStatus.textContent = 'Could not copy. Select @catsniffur above.';
          }
        });
      }
    </script>
  </body>
</html>
